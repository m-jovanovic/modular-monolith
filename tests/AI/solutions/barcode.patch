@@ -0,0 +1,134 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using EquipmentLibrary.Lending.IntegrationEvents;
+using Xunit;
+
+namespace EquipmentLibrary.PickupDesk.Tests;
+
+public sealed class BarcodeFilterTests(PickupFixture fixture) : IClassFixture<PickupFixture>, IAsyncLifetime
+{
+    private const string Queue = "/api/pickup-desk/queue";
+
+    public Task InitializeAsync() =>
+        fixture.ExecuteAsync("TRUNCATE pickup_desk.holds, pickup_desk.inbox, pickup_desk.redrives");
+
+    public Task DisposeAsync() => Task.CompletedTask;
+
+    [Fact]
+    public async Task StaffCanScanAnExactBarcodeWithSurroundingWhitespace()
+    {
+        HoldLifecycleEvent match = Place("DRILL-08");
+        HoldLifecycleEvent lowerCase = Place("drill-08");
+        HoldLifecycleEvent longer = Place("DRILL-080");
+        HoldLifecycleEvent closed = match with
+        {
+            MessageId = Guid.NewGuid(), EventType = HoldLifecycleEvent.Collected, Sequence = 2,
+            Data = match.Data with { HoldId = Guid.NewGuid(), State = "collected" }
+        };
+        await DeliverAsync(match, lowerCase, longer, closed);
+
+        Assert.Equal(match.Data.HoldId, Assert.Single(await ReadHoldIdsAsync("?barcode=%20DRILL-08%09")));
+        Assert.Empty(await ReadHoldIdsAsync("?barcode=DRILL"));
+        Assert.Empty(await ReadHoldIdsAsync("?barcode=DRILL%25"));
+        Assert.Equal(
+            new[] { match.Data.HoldId, lowerCase.Data.HoldId, longer.Data.HoldId }.Order(),
+            (await ReadHoldIdsAsync()).Order());
+    }
+
+    [Fact]
+    public async Task BarcodeCombinesWithCopyAndAssigneeAndIsAppliedBeforePagination()
+    {
+        const string barcode = "LAMP-02";
+        DateTimeOffset time = DateTimeOffset.UnixEpoch;
+        HoldLifecycleEvent other = Place("LAMP-03", time);
+        HoldLifecycleEvent first = Place(barcode, time.AddMinutes(1), Guid.Parse("00000000-0000-4000-8000-000000000003"));
+        // Terminal events for previous holds on this copy can still be in transit.
+        HoldLifecycleEvent second = first with
+        {
+            MessageId = Guid.NewGuid(), OccurredAt = time.AddMinutes(2),
+            Data = first.Data with { HoldId = Guid.Parse("00000000-0000-4000-8000-000000000001") }
+        };
+        HoldLifecycleEvent third = second with
+        {
+            MessageId = Guid.NewGuid(),
+            Data = second.Data with { HoldId = Guid.Parse("00000000-0000-4000-8000-000000000002") }
+        };
+        await DeliverAsync(third, second, first, other);
+        using HttpResponseMessage claim = await SendAsync(HttpMethod.Post, $"{Queue}/{second.Data.HoldId}/claim");
+        Assert.Equal(HttpStatusCode.NoContent, claim.StatusCode);
+
+        string filter = "?barcode=" + barcode;
+        Assert.Equal(new[] { first.Data.HoldId, second.Data.HoldId, third.Data.HoldId }, await ReadHoldIdsAsync(filter));
+        Assert.Equal(second.Data.HoldId, Assert.Single(await ReadHoldIdsAsync(filter + "&limit=1&offset=1")));
+        Assert.Empty(await ReadHoldIdsAsync(filter + $"&copyId={other.Data.CopyId}"));
+        string assignedCopy = filter + $"&copyId={first.Data.CopyId}&assignedTo=20000000-0000-4000-8000-000000000001";
+        Assert.Equal(second.Data.HoldId, Assert.Single(await ReadHoldIdsAsync(assignedCopy)));
+    }
+
+    [Fact]
+    public async Task EightyCharactersAfterTrimmingIsValid()
+    {
+        string barcode = new('B', 80);
+        HoldLifecycleEvent match = Place(barcode);
+        await DeliverAsync(match);
+        Assert.Equal(match.Data.HoldId, Assert.Single(await ReadHoldIdsAsync($"?barcode=%20{barcode}%20")));
+    }
+
+    [Theory]
+    [InlineData(0, 'B')]
+    [InlineData(2, ' ')]
+    [InlineData(81, 'B')]
+    public async Task BlankAndOverlongBarcodesReturnInvalidRequest(int length, char character)
+    {
+        string barcode = Uri.EscapeDataString(new string(character, length));
+        using HttpResponseMessage response = await SendAsync(HttpMethod.Get, Queue + "?barcode=" + barcode);
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        JsonElement problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("invalid-request", problem.GetProperty("code").GetString());
+        Assert.Equal("urn:equipment-library:problem:invalid-request", problem.GetProperty("type").GetString());
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+    }
+
+    [Theory]
+    [InlineData(null, HttpStatusCode.Unauthorized)]
+    [InlineData("borrower", HttpStatusCode.Forbidden)]
+    public async Task BarcodeSearchRequiresPickupPermission(string? actor, HttpStatusCode expected)
+    {
+        using HttpResponseMessage response = await SendAsync(HttpMethod.Get, Queue + "?barcode=DRILL-08", actor);
+        Assert.Equal(expected, response.StatusCode);
+    }
+
+    private static HoldLifecycleEvent Place(string barcode, DateTimeOffset? time = null, Guid? holdId = null) =>
+        new(Guid.NewGuid(), HoldLifecycleEvent.Placed, 1, 1, time ?? DateTimeOffset.UtcNow,
+            new(holdId ?? Guid.NewGuid(), Guid.NewGuid(), Guid.NewGuid(), barcode, "held"));
+
+    private async Task DeliverAsync(params HoldLifecycleEvent[] events)
+    {
+        foreach (HoldLifecycleEvent message in events)
+        {
+            await fixture.Inbox.AcceptAsync(message, default);
+            Assert.True(await fixture.Worker.ProcessNextAsync(default));
+        }
+    }
+
+    private async Task<Guid[]> ReadHoldIdsAsync(string query = "")
+    {
+        using HttpResponseMessage response = await SendAsync(HttpMethod.Get, Queue + query);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        JsonElement queue = await response.Content.ReadFromJsonAsync<JsonElement>();
+        return queue.GetProperty("items").EnumerateArray().Select(item => item.GetProperty("holdId").GetGuid()).ToArray();
+    }
+
+    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string path, string? actor = "staff")
+    {
+        using var request = new HttpRequestMessage(method, path);
+        if (actor is not null)
+        {
+            request.Headers.Add("X-Test-Actor", actor);
+        }
+
+        return await fixture.Client.SendAsync(request);
+    }
+}

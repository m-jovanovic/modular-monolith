+using EquipmentLibrary.Lending.IntegrationEvents;
+
+namespace EquipmentLibrary.PickupDesk.Queries;
+
+internal static class HoldRollup
+{
+    internal static int CountAwaitingPickup(IEnumerable<HoldLifecycleEvent> events)
+    {
+        var latestByHold = new Dictionary<Guid, HoldLifecycleEvent>();
+        foreach (HoldLifecycleEvent snapshot in events)
+        {
+            Guid holdId = snapshot.Data.HoldId;
+            if (!latestByHold.TryGetValue(holdId, out HoldLifecycleEvent? latest) || snapshot.Sequence > latest.Sequence)
+            {
+                latestByHold[holdId] = snapshot;
+            }
+        }
+
+        return latestByHold.Values.Count(snapshot => snapshot.Data.State == "held");
+    }
+}
